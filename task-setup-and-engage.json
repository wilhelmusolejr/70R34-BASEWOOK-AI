    { "type": "wait", "params": { "min": 20, "max": 40 } },

    { "type": "setup_about" },

    { "type": "wait", "params": { "min": 20, "max": 40 } },

    {
      "type": "setup_avatar",
      "guard": { "ifOnboardingMissing": "profileImageSetAt" },
      "chance": 1
    },

    { "type": "wait", "params": { "min": 20, "max": 40 } },

    {
      "type": "setup_cover",
      "guard": { "ifOnboardingMissing": "coverImageSetAt" },
      "chance": 1
    },

    { "type": "wait", "params": { "min": 20, "max": 40 } },

    {
      "type": "publish_post",
      "guard": { "ifOnboardingMissing": "publishPostAt" },
      "chance": 1,
      "params": { "captionSource": "paraphrase" }
