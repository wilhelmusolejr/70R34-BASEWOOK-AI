    { "type": "wait", "params": { "min": 20, "max": 40 } },

    {
      "type": "homepage_interaction",
      "steps": [{ "type": "scroll", "params": { "min": 40, "max": 60 } }]
    },

    {
      "type": "join_group",
      "guard": { "ifOnboardingMissing": "groupJoinedAt", "minAccountAgeDays": 7 },
