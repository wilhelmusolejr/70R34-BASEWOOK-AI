      "params": { "pool": "sharers" },
      "steps": [
        { "type": "scroll", "params": { "min": 30, "max": 60 } },
        { "type": "like_posts", "params": { "count": 2 } },
        { "type": "share_posts", "params": { "count": 1 } }
      ]
    },

    {
      "type": "visit_profile",
      "params": { "pool": "sharers" },
      "steps": [
        { "type": "scroll", "params": { "min": 30, "max": 60 } },
        { "type": "like_posts", "params": { "count": 2 } },
        { "type": "share_posts", "params": { "count": 1 } }
      ]
    }
  ]
