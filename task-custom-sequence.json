    { "type": "wait", "params": { "min": 30, "max": 60 } },

    { "type": "create_page", "chance": 1, "params": { "allowSharedPagePool": true } },

    { "type": "wait", "params": { "min": 30, "max": 60 } },

    { "type": "switch_profile", "chance": 1, "params": { "target": "user" } },

    { "type": "wait", "params": { "min": 30, "max": 60 } },

